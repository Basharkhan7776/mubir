# Environment variables for the web app (Vite)
# All variables exposed to the client must be prefixed with VITE_

# Backend server URL (used for Better Auth and data sync endpoints)
# Development (local server)
VITE_SERVER_URL=http://localhost:3001

# Production example:
# VITE_SERVER_URL=https://apimudir.basharkhan.com

# Google OAuth Web Client ID (used for client-side Google sign-in if needed,
# or to match the server-side GOOGLE_CLIENT_ID for the web app)
# IMPORTANT: This must be the SAME value as GOOGLE_CLIENT_ID in the server's .env
# (the Web application OAuth client ID from Google Cloud Console)
# Get it here: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
